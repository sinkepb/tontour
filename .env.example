# ─── Supabase ──────────────────────────────────────────────
# Laisser vide (ou supprimer ce fichier en .env.local) pour rester en MODE DÉMO :
# l'application fonctionne alors entièrement en local (localStorage + BroadcastChannel),
# sans backend, avec des données de démonstration pré-chargées.
#
# Pour connecter un vrai projet Supabase, renseigner ces deux valeurs
# (Dashboard Supabase → Project Settings → API) :
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── SMS de secours (optionnel, Priorité 2) ───────────────────
# Utilisé uniquement côté fonction Supabase Edge "notify-sms", jamais côté client.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
